# .env.example — 실제 .env 파일을 이 형식으로 작성 후 gitignore에 추가
# 절대 학번/비밀번호를 여기에 넣지 마세요.

# SendGrid (또는 SMTP) — 데모용 테스트 주소로만 실제 발송
SENDGRID_API_KEY=your_sendgrid_api_key_here
DEMO_EMAIL_SENDER=your_verified_sender@example.com
DEMO_EMAIL_RECIPIENT=your_test_email@example.com

# SMTP 대체 사용 시
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# WxO 환경 (orchestrate CLI 사용 시)
# IBM_CLOUD_API_KEY=your_ibm_cloud_api_key
# WXO_INSTANCE_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/YOUR_INSTANCE_ID
